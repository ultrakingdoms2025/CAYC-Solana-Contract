# Mainnet env. Copy to `.env.mainnet` and fill in the REAL values.
# CRITICAL: Mainnet mint/freeze/update authority NEVER lives in a JSON keypair.
# All mainnet authority actions are signed via Ledger + Phantom through the Squads v4 web UI.
# Scripts only BUILD proposals; they do not SIGN them for mainnet.

SOLANA_CLUSTER=mainnet-beta

# Helius Business tier mainnet RPC. Generate a NEW key in your Helius dashboard —
# do NOT reuse your devnet key (separate quotas, separate access control).
HELIUS_MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=REPLACE_WITH_MAINNET_KEY
HELIUS_MAINNET_WS_URL=wss://mainnet.helius-rpc.com/?api-key=REPLACE_WITH_MAINNET_KEY

# Optional secondary RPC (Triton or QuickNode) for redundancy during the ceremony.
MAINNET_FALLBACK_RPC=

# Mainnet proposer keypair (pays rent + tx fees; does NOT hold any mint authority).
# Even this keypair should be minimized — use a fresh, funded wallet that holds only SOL for fees.
# Example: MAINNET_PROPOSER_KEYPAIR_PATH=~/.config/solana/id-mainnet-proposer.json
MAINNET_PROPOSER_KEYPAIR_PATH=

# Mainnet voting signer PUBKEYS (5 total — not keypairs; the private keys live on Ledger devices).
# Each signer provides their pubkey during Stage B of the preflight runbook. Fill after each signer
# has: (1) generated their seed on Ledger, (2) installed the Solana app, (3) enabled Blind Signing.
# These are READ-ONLY values used by the preflight script to check on-chain SOL balances.
MAINNET_SIGNER_1_PUBKEY=
MAINNET_SIGNER_2_PUBKEY=
MAINNET_SIGNER_3_PUBKEY=
MAINNET_SIGNER_4_PUBKEY=
MAINNET_SIGNER_5_PUBKEY=

# Mainnet Squads multisig (populated AFTER Plan 02-05 mainnet ceremony completes).
MAINNET_SQUADS_MULTISIG_ADDRESS=
MAINNET_SQUADS_VAULT_PDA=

# Mainnet mint artifact (populated AFTER Phase 4 mainnet launch ceremony completes).
MAINNET_MINT_ADDRESS=

# Explicit mainnet confirmation flag — scripts must abort unless this is literally "yes-mainnet-ceremony".
# Prevents accidental mainnet execution from a developer machine.
CONFIRM_MAINNET=no
