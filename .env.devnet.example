# Devnet env. Copy to `.env.devnet` and fill in HELIUS_DEVNET_RPC_URL.
# This file is ONLY ever used for devnet work. Safe keypair paths only; no mainnet keys.

SOLANA_CLUSTER=devnet
HELIUS_DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=REPLACE_WITH_DEVNET_KEY
HELIUS_DEVNET_WS_URL=wss://devnet.helius-rpc.com/?api-key=REPLACE_WITH_DEVNET_KEY

# Devnet fallback (public RPC — rate-limited but unauthenticated; fine for `solana airdrop`).
SOLANA_DEVNET_FALLBACK_RPC=https://api.devnet.solana.com

# Devnet signer keypair path (JSON keypair — devnet-only).
DEVNET_DEPLOYER_KEYPAIR_PATH=~/.config/solana/id-devnet.json

# Devnet Squads multisig (populated after Phase 2 Plan creates the devnet multisig).
DEVNET_SQUADS_MULTISIG_ADDRESS=
DEVNET_SQUADS_VAULT_PDA=

# Devnet mint artifact (populated after Phase 3 rehearsal).
DEVNET_MINT_ADDRESS=
