# CAYC repo — network-agnostic env template.
# Copy to `.env` for local defaults. Override per-network via `.env.devnet` / `.env.mainnet`.
# NEVER commit a populated .env file. Gitleaks will block it; .gitignore blocks it; this line exists for the third defensive layer.

# Default cluster for scripts when no explicit --network flag is passed.
# MUST default to 'devnet'. Set to 'mainnet-beta' ONLY via an explicit env var or CLI flag — never as the default.
SOLANA_CLUSTER=devnet

# Primary Helius RPC (devnet credentials by default — never ship mainnet keys in plain .env).
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=REPLACE_WITH_DEVNET_KEY

# Path to the default signer keypair (NOT the key itself). Scripts read the path and load the JSON at runtime.
# Mainnet authority NEVER lives in a JSON keypair — mainnet uses Ledger via Squads UI.
DEPLOYER_KEYPAIR_PATH=~/.config/solana/id-devnet.json

# Log verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Ceremony artifact directory (relative to repo root). Scripts write transcripts here.
ARTIFACT_DIR=./artifacts
